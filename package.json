{
  "name": "parallax-vanilla",
  "version": "2.0.1-rc.0",
  "description": "Lightweight, dependency-free parallax scrolling for images and videos.",
  "author": "Erik Engervall erik.engervall@gmail.com https://github.com/erikengervall",
  "license": "MIT",
  "homepage": "https://erikengervall.github.io/parallax-vanilla/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erikengervall/parallax-vanilla.git"
  },
  "bugs": "https://github.com/erikengervall/parallax-vanilla/issues",
  "keywords": [
    "vanilla",
    "javascript",
    "parallax",
    "scroll",
    "animation",
    "video",
    "library"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/parallax-vanilla.js",
  "jsdelivr": "./dist/parallax-vanilla.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./parallax-vanilla.css": "./dist/parallax-vanilla.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/parallax-vanilla.js",
    "*.css"
  ],
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsup",
    "dev": "tsup --watch --onSuccess \"node scripts/dev-server.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.2.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
